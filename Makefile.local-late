# Hand-written rules, included at the end of the coq_makefile Makefile.
#
# make verify: coqchk + assumption audit (after a successful make all).
# make check-proofs / make check-axioms: run those steps alone.

ASSUMPTIONS_LOG := build/assumptions.log
VERIFY_THEOREMS := 29

.PHONY: verify check-proofs check-axioms check-no-cheats
verify: all check-no-cheats check-proofs check-axioms

check-no-cheats:
	@echo "Checking for Admitted / Axiom / cheat in theories/*.v..."
	@if grep -Rn 'Admitted\.' theories --include='*.v'; then \
	  echo "ERROR: Admitted found (coqc should also fail with -w +admitted-proof)"; exit 1; fi
	@if grep -Rn '^[[:space:]]*Axiom[[:space:]]' theories --include='*.v'; then \
	  echo "ERROR: Axiom declarations are not allowed in theories/"; exit 1; fi
	@if grep -Rni 'cheat' theories --include='*.v' | grep -v verify_assumptions; then \
	  echo "ERROR: suspicious cheat identifier in theories/"; exit 1; fi

check-proofs: all
	@echo "coqchk on $$(echo $(VOFILES) | wc -w | tr -d ' ') .vo files..."
	$(COQCHK) $(COQCHKFLAGS) $(COQLIBS_NOML) $(VOFILES)

check-axioms: all
	@mkdir -p build
	@echo "Print Assumptions audit (theories/verify_assumptions.v)..."
	$(COQC) $(COQFLAGS) $(COQLIBS) theories/verify_assumptions.v > $(ASSUMPTIONS_LOG) 2>&1
	@if grep -iE 'admit|cheat|unfinished proof' $(ASSUMPTIONS_LOG); then \
	  echo "ERROR: admissions or cheats in assumption audit:"; cat $(ASSUMPTIONS_LOG); exit 1; fi
	@closed=$$(grep -c 'Closed under the global context' $(ASSUMPTIONS_LOG) || true); \
	if [ "$$closed" -lt $(VERIFY_THEOREMS) ]; then \
	  echo "ERROR: expected $(VERIFY_THEOREMS) theorems closed under global context, got $$closed"; \
	  cat $(ASSUMPTIONS_LOG); exit 1; fi; \
	echo "Assumption audit OK ($$closed/$(VERIFY_THEOREMS) theorems closed)."

#
# make cj: print every example as Cangjie into generated/cj/, write
# generated/cj/further.tex for emitted files the tutorial does not name yet,
# and rebuild paper/cjr-tutorial.pdf.

CJ_DIR := generated/cj
CJ_RAW := $(CJ_DIR)/bundle.raw
CJ_TEX := paper/cjr-tutorial.tex
CJ_EXPECTED := arith struct_upd cell swap sum_block class_upd frame_call \
  vtable list list_rev array array_list hash_map qsort_array qsort_array_list

.PHONY: cj
cj:
	mkdir -p $(CJ_DIR)
	$(MAKE) theories/examples/emit_cj.vo
	rm -f $(CJ_RAW).out $(CJ_DIR)/*.cj
	printf '%s\n' \
	  'From Coq Require Import String.' \
	  'From cjr.examples Require Import emit_cj.' \
	  'Open Scope string_scope.' \
	  'Redirect "$(CJ_RAW)" Eval vm_compute in cj_bundle.' \
	  | $(COQBIN)coqtop -q -output-directory . $(COQMF_COQLIBS_NOML) > /dev/null
	test -s $(CJ_RAW).out
	perl -0777 -ne ' \
	  m/\A\s*=\s*"(.*)"(?:%string)?\s*:\s*string\s*\z/s \
	    or die "cj: unexpected coqtop output\n"; \
	  my $$s = $$1; $$s =~ s/""/"/g; \
	  for my $$c (split /^\@\@FILE /m, $$s) { \
	    next unless length $$c; \
	    my ($$n, $$b) = split /\n/, $$c, 2; \
	    open my $$f, ">", "$(CJ_DIR)/$$n.cj" or die "cj: $$n: $$!\n"; \
	    print $$f $$b; close $$f; \
	  }' $(CJ_RAW).out
	rm -f $(CJ_RAW).out
	@for n in $(CJ_EXPECTED); do \
	  test -s $(CJ_DIR)/$$n.cj || { echo "cj: missing $(CJ_DIR)/$$n.cj"; exit 1; }; \
	done
	@if grep -l unsupported $(CJ_DIR)/*.cj; then \
	  echo "cj: the files above contain an unsupported form"; exit 1; \
	fi
	@for f in 'func grow' 'func add' 'func remove'; do \
	  grep -q "$$f" $(CJ_DIR)/array_list.cj || { echo "cj: array_list.cj lacks $$f"; exit 1; }; \
	done
	@for f in 'func grow' 'func add' 'func remove' 'func contains' 'func get'; do \
	  grep -q "$$f" $(CJ_DIR)/hash_map.cj || { echo "cj: hash_map.cj lacks $$f"; exit 1; }; \
	done
	@{ echo '% Generated by make cj: emitted examples that cjr-tutorial.tex does not list.'; \
	  for v in $$(grep '^theories/examples/.*\.v$$' _CoqProject); do \
	    n=$$(basename $$v .v); \
	    if [ -f $(CJ_DIR)/$$n.cj ] && ! grep -q "$(CJ_DIR)/$$n.cj" $(CJ_TEX); then \
	      t=$$(printf '%s' "$$n" | sed 's/_/\\_/g'); \
	      printf '\\subsection{\\texttt{%s.cj}}\n\\lstinputlisting{$(CJ_DIR)/%s.cj}\n\n' "$$t" "$$n"; \
	    fi; \
	  done; } > $(CJ_DIR)/further.tex
	pdflatex -interaction=nonstopmode -halt-on-error -output-directory=paper $(CJ_TEX)
	pdflatex -interaction=nonstopmode -halt-on-error -output-directory=paper $(CJ_TEX)
