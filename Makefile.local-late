# Hand-written rules, included at the end of the coq_makefile Makefile.
#
# make verify: coqchk + assumption audit (after a successful make all).
# make check-proofs / make check-axioms: run those steps alone.

ASSUMPTIONS_LOG := build/assumptions.log
PYTHON ?= python3
EXPLANATIONS ?= auto
REPORT_FLAGS ?=

# Moving load paths invalidates compiled resolution data as well as objects.
$(VOFILES): _CoqProject
$(foreach config,$(wildcard example/*/_CoqProject),$(eval $(filter $(dir $(config))%,$(VOFILES)): $(config)))

# Optional documentation tooling; proof verification does not depend on it.
.PHONY: readable readable-test project-tools-test generic-extraction-test
# The assumption audit contains only Print commands, not declarations to render.
readable:
	$(PYTHON) -m tools.rocq_readable build --sources $(filter-out theories/verify_assumptions.v,$(wildcard theories/*.v)) tools/extraction/rocq --output generated/spec-html --explanations $(EXPLANATIONS)
	$(PYTHON) -m tools.project_tools.examples readable --explanations $(EXPLANATIONS)

readable-test:
	$(PYTHON) -m unittest discover -s tests -p 'test_rocq_readable.py' -v

project-tools-test:
	$(PYTHON) -m unittest discover -s tests -p 'test_project_tools.py' -v

generic-extraction-test: example/generics/rocq/generic_tests.vo example/poly_array/rocq/poly_array_tests.vo
	$(PYTHON) -m unittest discover -s tests -p 'test_generic_extraction.py' -v

VERIFY_LOG ?= build/verify.log
VERIFY_THEOREMS := 999

.PHONY: verify verify-checks check-proofs check-axioms check-no-cheats
# A recursive make keeps all build/check output inside the log and preserves
# the parallel jobserver. pipefail prevents tee from hiding a failed check.
verify: SHELL := /bin/bash
verify:
	+@set -o pipefail; mkdir -p "$(dir $(VERIFY_LOG))" || exit $$?; \
	{ printf 'make verify started: %s\n' "$$(date -u '+%Y-%m-%dT%H:%M:%SZ')"; \
	  $(MAKE) --no-print-directory verify-checks; status=$$?; \
	  printf 'make verify finished: %s (exit status %s)\n' "$$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$$status"; \
	  exit $$status; } 2>&1 | tee "$(VERIFY_LOG)"

verify-checks: all check-no-cheats check-proofs check-axioms quadtree-verify

check-no-cheats:
	@echo "Checking for Admitted / Axiom / cheat in theories/*.v..."
	@if grep -Rn 'Admitted\.' theories example tools/extraction/rocq --include='*.v'; then \
	  echo "ERROR: Admitted found (coqc should also fail with -w +admitted-proof)"; exit 1; fi
	@if grep -Rn '^[[:space:]]*Axiom[[:space:]]' theories example tools/extraction/rocq --include='*.v'; then \
	  echo "ERROR: Axiom declarations are not allowed in theories/"; exit 1; fi
	@if grep -Rni 'cheat' theories example tools/extraction/rocq --include='*.v' | grep -v verify_assumptions; then \
	  echo "ERROR: suspicious cheat identifier in theories/"; exit 1; fi

check-proofs: all
	@echo "coqchk on $$(echo $(VOFILES) | wc -w | tr -d ' ') .vo files..."
	$(COQCHK) $(COQCHKFLAGS) $(COQLIBS_NOML) $(VOFILES)

check-axioms: all
	@mkdir -p build
	@echo "Print Assumptions audit (theories/verify_assumptions.v)..."
	$(COQC) $(COQFLAGS) $(COQLIBS) theories/verify_assumptions.v > $(ASSUMPTIONS_LOG) 2>&1
	@if grep -iE 'admit|cheat|unfinished proof' $(ASSUMPTIONS_LOG); then \
	  echo "ERROR: admissions or cheats in assumption audit:"; cat $(ASSUMPTIONS_LOG); exit 1; fi
	@closed=$$(grep -c 'Closed under the global context' $(ASSUMPTIONS_LOG) || true); \
	if [ "$$closed" -lt $(VERIFY_THEOREMS) ]; then \
	  echo "ERROR: expected $(VERIFY_THEOREMS) theorems closed under global context, got $$closed"; \
	  cat $(ASSUMPTIONS_LOG); exit 1; fi; \
	echo "Assumption audit OK ($$closed/$(VERIFY_THEOREMS) theorems closed)."

# Aggregate extraction preserves the printer and writes local outputs.
.PHONY: extract cj test
extract: tools/extraction/rocq/emit_cj.vo example/authenticator/core/rocq/extract.vo
	$(PYTHON) -m tools.project_tools.examples extract
	$(PYTHON) example/authenticator/core/scripts/check.py --extract-only
cj: extract
	pdflatex -interaction=nonstopmode -halt-on-error -output-directory=paper paper/cjr-tutorial.tex
	pdflatex -interaction=nonstopmode -halt-on-error -output-directory=paper paper/cjr-tutorial.tex
test: extract generic-extraction-test
	$(PYTHON) -m tools.project_tools.examples test
	$(PYTHON) example/authenticator/core/scripts/check.py --test-only

# Self-contained quadtree example and offline report.
.PHONY: quadtree quadtree-verify quadtree-report benchmark benchmark-most-frequent project-report
quadtree:
	$(MAKE) -C example/quadtree build
quadtree-verify: all
	$(MAKE) -C example/quadtree verify
quadtree-report:
	$(MAKE) -C example/quadtree report

# Shared project benchmark runner, normalizer, charting and offline reports.
benchmark: extract
	$(PYTHON) -m tools.project_tools.examples benchmark

benchmark-most-frequent: extract
	$(PYTHON) -m tools.project_tools.examples benchmark --example most_frequent

project-report: readable
	$(PYTHON) -m tools.project_tools.examples report $(REPORT_FLAGS)
