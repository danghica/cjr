foreign func free(ptr: CPointer<Unit>): Unit

class Node {
    public var isCons: Bool
    public var value: Int64
    var next_raw: ?Node
    public mut prop next: Node {
        get() {
            match (this.next_raw) {
                case Some(n) => n
                case None => this
            }
        }
        set(n) { this.next_raw = n }
