foreign func malloc(size: UIntNative): CPointer<Unit>
foreign func free(ptr: CPointer<Unit>): Unit

struct Int64Option {
    public var ok: Bool
    public var value: Int64
    public init(ok: Bool, value: Int64) {
        this.ok = ok
        this.value = value
    }
}

class Array {
    public var len: Int64
    public var data: CPointer<Int64>
    public init(len: Int64, data: CPointer<Int64>) {
        this.len = len
        this.data = data
    }
}

func make(n: Int64): Array {
    let p = unsafe { CPointer<Int64>(malloc(UIntNative(8 * n))) }
    Array(n, p)
}

func length(a: Array): Int64 {
    a.len
}

func get(arr: Array, i: Int64): Int64 {
    let p = arr.data
    unsafe { (p + i).read() }
}

func set(arr: Array, i: Int64, x: Int64): Unit {
    let p = arr.data
    unsafe { (p + i).write(x) }
}

func pairSwap(values: Array, indices: Array, i: Int64, j: Int64): Unit {
    let x = get(values, i)
    let xi = get(indices, i)
    let y = get(values, j)
    let yi = get(indices, j)
    set(values, i, y)
    set(indices, i, yi)
    set(values, j, x)
    set(indices, j, xi)
}

func pairPartition(values: Array, indices: Array, lo: Int64, hi: Int64): Int64 {
    let pv = get(values, hi - 1)
    let pi = get(indices, hi - 1)
    var i = lo
    var j = lo
    while ((j + 1) <= (hi - 1)) {
        let v = get(values, j)
        let ix = get(indices, j)
        if (if (v <= pv) {
            if (pv <= v) { ix <= pi } else { true }
        } else {
            false
        }) {
            pairSwap(values, indices, i, j)
            i = i + 1
        }
        j = j + 1
    }
    pairSwap(values, indices, i, hi - 1)
    i
}

func pairQsort(values: Array, indices: Array, lo: Int64, hi: Int64): Unit {
    if ((lo + 1) <= (hi - 1)) {
        let p = pairPartition(values, indices, lo, hi)
        pairQsort(values, indices, lo, p)
        pairQsort(values, indices, p + 1, hi)
    }
}

func mostFrequent(input: Array): Int64Option {
    let n = length(input)
    if (n == 0) {
        Int64Option(false, 0)
    } else {
        let values = make(n)
        let indices = make(n)
        var copyAt = 0
        while ((copyAt + 1) <= n) {
            set(values, copyAt, get(input, copyAt))
            set(indices, copyAt, copyAt)
            copyAt = copyAt + 1
        }
        pairQsort(values, indices, 0, n)
        var bestValue = get(values, 0)
        var bestCount = 0
        var bestFirst = n
        var start = 0
        while ((start + 1) <= n) {
            let value = get(values, start)
            var end = start + 1
            var first = get(indices, start)
            while (if ((end + 1) <= n) {
                get(values, end) == value
            } else {
                false
            }) {
                let ix = get(indices, end)
                if ((ix + 1) <= first) {
                    first = ix
                }
                end = end + 1
            }
            let count = end - start
            if (if ((bestCount + 1) <= count) {
                true
            } else {
                if (bestCount == count) {
                    (first + 1) <= bestFirst
                } else {
                    false
                }
            }) {
                bestValue = value
                bestCount = count
                bestFirst = first
            }
            start = end
        }
        unsafe { free(CPointer<Unit>(values.data)) }
        unsafe { free(CPointer<Unit>(indices.data)) }
        Int64Option(true, bestValue)
    }
}

main(): Unit {
    let input = make(1)
    set(input, 0, 42)
    mostFrequent(input)
}
